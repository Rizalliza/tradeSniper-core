{
  "name": "tradesniper-core",
  "version": "2.0.0",
  "engines": { "node": ">=18" },
  "description": "TradeSniper marker-retest stock trading strategy engine",
  "type": "module",
  "main": "src/strategies/SniperStrategy.js",
  "scripts": {
    "test": "node --test tests/**/*.test.js tests/*.test.js",
    "backtest": "node scripts/runBacktest.js",
    "backtest:gen": "node scripts/generateTestData.js && node scripts/runBacktest.js --bars data/test_minute_bars.csv",
    "buffer:analyze": "node scripts/bufferAnalysis.js",
    "massive:backtest": "node -r dotenv/config scripts/massiveBacktest.js",
    "massive:export-agents": "node -r dotenv/config scripts/exportAgentMassiveData.js",
    "opening:paper": "node scripts/openingSniperPaperReplay.js",
    "opening:paper:review": "node scripts/openingPaperReviewDeck.js",
    "opening:retest-study": "node scripts/openingRetestBufferStudy.js",
    "opening:wait-study": "node scripts/openingWaitConfirmationStudy.js",
    "opening:wait:review": "node scripts/openingWaitReviewDeck.js",
    "opening:wait-study:confirmed-exit": "node scripts/openingWaitConfirmationStudy.js --exit-confirm-mode close-through --out data/opening-wait-confirmed-exit-study-2026-09-09_2026-09-15.json",
    "opening:wait:confirmed-exit:review": "node scripts/openingWaitReviewDeck.js --study data/opening-wait-confirmed-exit-study-2026-09-09_2026-09-15.json --out webapp/opening-wait-confirmed-exit-review.html",
    "opening:wait-study:separation": "node scripts/openingWaitConfirmationStudy.js --exit-confirm-mode close-through --retest-min-separation-bars 2 --out data/opening-wait-separation-study-2026-09-09_2026-09-15.json",
    "opening:wait:separation:review": "node scripts/openingWaitReviewDeck.js --study data/opening-wait-separation-study-2026-09-09_2026-09-15.json --out webapp/opening-wait-separation-review.html",
    "opening:multi-event": "node scripts/openingMultiEventScanner.js",
    "opening:multi-event:review": "node scripts/openingMultiEventReviewDeck.js",
    "opening:multi-event:assess": "node scripts/openingMultiEventAssessment.js",
    "opening:multi-event:assess:review": "node scripts/openingMultiEventAssessmentDeck.js",
    "opening:shadow": "node -r dotenv/config scripts/openingSniperLiveShadow.js",
    "webapp:dev": "node scripts/serve.js --port 3000",
    "start": "node scripts/serve.js",
    "sniper:live": "node scripts/sniper-live.js"
  },
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "dotenv": "^16.4.0"
  }
}
